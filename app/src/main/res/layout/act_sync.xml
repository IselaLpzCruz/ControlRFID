<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menuPrincipal_SincronizacionDeDatos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSincronizarCatalogos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txt_SincronizarCatalogos"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtTotalPorAuditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txt_NoTieneActivosParaSync"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSubirPendientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txt_SubirInventariosAlSoftwareCentral"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRegresarSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_back" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarSync"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone" />

</RelativeLayout>
